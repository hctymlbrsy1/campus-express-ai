# 复制为 .env 后填写；不配置也能运行（模块四自动降级为知识库检索）
# 阿里云百炼（推荐，有免费额度）
DASHSCOPE_API_KEY=
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 专属 MaaS 端点示例（把 base_url/model 换成控制台给的那组）
# LLM_BASE_URL=https://llm-aljxvtaeii9amnp1.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen4-max

# 深度思考模型：打开后会用流式读取 reasoning_content
# 注意：三策略对比建议保持 false，否则"是否开思考"会和"提示词策略"混在一起
LLM_ENABLE_THINKING=false
LLM_MAX_TOKENS=800
LLM_TIMEOUT=60

# 智谱 AI（备选）
# ZHIPUAI_API_KEY=
# LLM_MODEL=glm-4-flash
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4